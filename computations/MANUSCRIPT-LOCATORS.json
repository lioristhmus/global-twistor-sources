      "formula": "\\begin{aligned}\nH((\\sigma,\\mu,\\rho),(\\sigma',\\mu',\\rho'))\n &=\\sigma\\rho'+\\rho\\sigma'+g(\\mu,\\mu'),\\\\\nD_v(\\sigma,\\mu,\\rho)\n &=\\bigl(v\\sigma-g(v,\\mu),\\,\n       \\nabla_v\\mu+((\\Lambda/6)\\sigma+\\rho)v,\\,\n       v\\rho-(\\Lambda/6)g(v,\\mu)\\bigr),\\\\\n\\mathsf X&=(0,0,1),\\qquad\n\\mathsf I=(1,0,-\\Lambda/6).\n\\end{aligned}",
      "unchanged_from_v091": true,
